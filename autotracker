<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>AUTOTRACK</title>
<link rel="icon" type="image/png" href="data:image/png;base64,">
<link rel="apple-touch-icon" href="data:image/png;base64,">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Autotrack">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;900&family=Inter:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0a0a0a;
    --surface:#131313;
    --surface-2:#1a1a1a;
    --border:#262626;
    --text:#f4f3ee;
    --text-dim:#8c8b86;
    --text-faint:#4d4d49;
    --lime:#d7ff3d;
    --lime-dim:#a8cc1f;
    --danger:#ff5a5a;
    --radius:2px;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html,body{
    background:var(--bg);
    color:var(--text);
    font-family:'Inter',sans-serif;
    -webkit-font-smoothing:antialiased;
    height:100%;
    overscroll-behavior:none;
  }
  #app{
    max-width:460px;
    min-height:100vh;
    margin:0 auto;
    position:relative;
    background:var(--bg);
    display:flex;
    flex-direction:column;
  }
  .eyebrow{
    font-family:'Space Mono',monospace;
    font-size:11px;
    letter-spacing:0.18em;
    text-transform:uppercase;
    color:var(--lime);
  }
  h1,h2,h3{
    font-family:'Archivo',sans-serif;
    font-weight:900;
    letter-spacing:-0.02em;
    line-height:1.02;
    text-transform:uppercase;
  }
  .btn{
    font-family:'Inter',sans-serif;
    font-weight:600;
    font-size:12px;
    letter-spacing:0.08em;
    text-transform:uppercase;
    border:1px solid var(--border);
    background:transparent;
    color:var(--text);
    padding:14px 20px;
    border-radius:var(--radius);
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    cursor:pointer;
    transition:all .15s ease;
  }
  .btn:active{transform:scale(0.97);}
  .btn:hover{border-color:var(--text-dim);}
  .btn-lime{
    background:var(--lime);
    border-color:var(--lime);
    color:#0a0a0a;
    font-weight:700;
  }
  .btn-lime:hover{background:var(--lime-dim); border-color:var(--lime-dim);}
  .btn-block{width:100%;}
  input,select,textarea{
    font-family:'Inter',sans-serif;
    background:var(--surface-2);
    border:1px solid var(--border);
    color:var(--text);
    padding:13px 14px;
    border-radius:var(--radius);
    font-size:15px;
    width:100%;
    outline:none;
  }
  input::placeholder,textarea::placeholder{color:var(--text-faint);}
  input:focus,select:focus,textarea:focus{border-color:var(--lime);}
  label{
    font-size:11px;
    letter-spacing:0.1em;
    text-transform:uppercase;
    color:var(--text-dim);
    display:block;
    margin-bottom:8px;
  }

  /* HERO */
  .topbar{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:20px 20px 16px;
  }
  .logo{
    display:flex;
    align-items:center;
    gap:8px;
    font-family:'Archivo',sans-serif;
    font-weight:900;
    font-size:15px;
    letter-spacing:0.02em;
  }
  .logo .mark{
    width:22px;height:22px;
    background:var(--lime);
    color:#0a0a0a;
    display:flex;align-items:center;justify-content:center;
    font-size:13px;
    border-radius:1px;
  }
  .hero{
    position:relative;
    margin:0 20px 0;
    aspect-ratio:16/11;
    border-radius:6px;
    overflow:hidden;
    background:var(--surface);
    border:1px solid var(--border);
  }
  .hero img{
    width:100%;height:100%;object-fit:cover;display:block;
  }
  .hero .empty-hero{
    position:absolute;inset:0;
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    gap:14px;
    color:var(--text-faint);
  }
  .hero .empty-hero svg{opacity:0.5;}
  .hero-overlay{
    position:absolute; left:0; right:0; bottom:0;
    padding:16px;
    background:linear-gradient(0deg, rgba(0,0,0,0.75), transparent 70%);
    display:flex; align-items:flex-end; justify-content:space-between;
  }
  .hero-name{
    font-family:'Archivo',sans-serif;
    font-weight:900;
    font-size:20px;
    text-transform:uppercase;
    letter-spacing:-0.01em;
  }
  .hero-sub{
    font-family:'Space Mono',monospace;
    font-size:10px;
    color:var(--lime);
    letter-spacing:0.12em;
    text-transform:uppercase;
    margin-top:2px;
  }
  .hero-edit{
    width:36px;height:36px;
    border:1px solid rgba(255,255,255,0.3);
    background:rgba(10,10,10,0.5);
    backdrop-filter:blur(4px);
    display:flex;align-items:center;justify-content:center;
    border-radius:50%;
    cursor:pointer;
    flex-shrink:0;
  }

  /* STAT STRIP */
  .stats{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    margin:22px 20px 0;
    border-top:1px solid var(--border);
    border-bottom:1px solid var(--border);
  }
  .stat{
    padding:16px 6px;
    text-align:center;
    border-left:1px solid var(--border);
  }
  .stat:first-child{border-left:none;}
  .stat .val{
    font-family:'Archivo',sans-serif;
    font-weight:900;
    font-size:19px;
    letter-spacing:-0.02em;
  }
  .stat .lbl{
    font-size:9px;
    letter-spacing:0.06em;
    text-transform:uppercase;
    color:var(--text-dim);
    margin-top:4px;
  }

  /* SECTION */
  .section{padding:28px 20px 0;}
  .section-head{
    display:flex;align-items:baseline;justify-content:space-between;
    margin-bottom:14px;
  }
  .section-head h2{font-size:20px;}
  .section-link{
    font-size:11px;letter-spacing:0.08em;text-transform:uppercase;
    color:var(--text-dim); cursor:pointer;
  }

  /* EXPENSE ROWS */
  .expense-row{
    display:flex; align-items:center; gap:12px;
    padding:14px 0;
    border-bottom:1px solid var(--border);
  }
  .expense-row:last-child{border-bottom:none;}
  .cat-dot{
    width:8px;height:8px;border-radius:50%;flex-shrink:0;
  }
  .expense-info{flex:1; min-width:0;}
  .expense-cat{font-size:14px; font-weight:500;}
  .expense-meta{font-size:11px; color:var(--text-dim); margin-top:2px;}
  .expense-amt{
    font-family:'Space Mono',monospace;
    font-size:14px;
    font-weight:700;
    white-space:nowrap;
  }
  .expense-del{
    color:var(--text-faint);
    cursor:pointer;
    padding:4px;
    flex-shrink:0;
  }
  .expense-del:hover{color:var(--danger);}
  .empty-state{
    padding:40px 0;
    text-align:center;
    color:var(--text-faint);
    font-size:13px;
  }

  /* BOTTOM NAV */
  .bottom-nav{
    position:sticky; bottom:0;
    margin-top:auto;
    display:flex;
    border-top:1px solid var(--border);
    background:rgba(10,10,10,0.92);
    backdrop-filter:blur(8px);
  }
  .nav-item{
    flex:1;
    display:flex; flex-direction:column; align-items:center; gap:5px;
    padding:12px 0 14px;
    color:var(--text-faint);
    cursor:pointer;
  }
  .nav-item.active{color:var(--lime);}
  .nav-item span{
    font-size:9px; letter-spacing:0.06em; text-transform:uppercase; font-weight:600;
  }
  .fab-slot{flex:1; display:flex; align-items:center; justify-content:center;}
  .fab{
    width:48px;height:48px;
    background:var(--lime);
    color:#0a0a0a;
    border-radius:50%;
    display:flex;align-items:center;justify-content:center;
    margin-top:-22px;
    border:4px solid var(--bg);
    cursor:pointer;
  }
  .fab:active{transform:scale(0.94);}

  .screen{display:none; flex:1; flex-direction:column;}
  .screen.active{display:flex;}

  /* SHEET / MODAL */
  .sheet-backdrop{
    position:fixed; inset:0;
    background:rgba(0,0,0,0.6);
    display:none;
    align-items:flex-end;
    justify-content:center;
    z-index:50;
  }
  .sheet-backdrop.active{display:flex;}
  .sheet{
    background:var(--bg);
    border:1px solid var(--border);
    border-bottom:none;
    width:100%;
    max-width:460px;
    border-radius:16px 16px 0 0;
    padding:22px 20px 28px;
    max-height:88vh;
    overflow-y:auto;
  }
  .sheet-head{
    display:flex;align-items:center;justify-content:space-between;
    margin-bottom:20px;
  }
  .sheet-close{
    width:30px;height:30px;
    display:flex;align-items:center;justify-content:center;
    color:var(--text-dim);
    cursor:pointer;
  }
  .field{margin-bottom:16px;}
  .chip-row{
    display:flex; flex-wrap:wrap; gap:8px;
  }
  .chip{
    border:1px solid var(--border);
    padding:9px 14px;
    border-radius:20px;
    font-size:12px;
    color:var(--text-dim);
    cursor:pointer;
    display:flex; align-items:center; gap:6px;
    user-select:none;
  }
  .chip.selected{
    border-color:var(--lime);
    color:var(--lime);
    background:rgba(215,255,61,0.08);
  }
  .amount-input-wrap{position:relative;}
  .amount-input-wrap .curr{
    position:absolute; left:14px; top:50%; transform:translateY(-50%);
    color:var(--text-dim); font-size:15px; pointer-events:none;
  }
  .amount-input-wrap input{padding-left:32px; font-family:'Space Mono',monospace; font-size:18px;}
  .err{color:var(--danger); font-size:12px; margin-top:6px; display:none;}

  /* SETTINGS / EMPTY-CAR ONBOARD */
  .onboard{
    flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center;
    padding:40px 28px; text-align:center; gap:20px;
  }
  .onboard .zmark{
    width:44px;height:44px; background:var(--lime); color:#0a0a0a;
    display:flex;align-items:center;justify-content:center; border-radius:2px;
    font-family:'Archivo',sans-serif; font-weight:900; font-size:22px;
  }
  .onboard h1{font-size:26px; margin-top:6px;}
  .onboard p{color:var(--text-dim); font-size:14px; line-height:1.5; max-width:280px;}

  .divider-label{
    font-family:'Space Mono',monospace;
    font-size:10px; letter-spacing:0.15em; text-transform:uppercase;
    color:var(--text-faint);
    margin:24px 20px 12px;
  }

  #photoInput{display:none;}

  ::-webkit-scrollbar{width:0px;}
</style>
</head>
<body>
<div id="app">

  <!-- ONBOARDING SCREEN -->
  <div class="screen active" id="screen-onboard">
    <div class="onboard">
      <div class="zmark">A</div>
      <h1>Autotrack</h1>
      <p>Додайте своє авто та фото, щоб почати відстежувати витрати — паливо, сервіс, страховку і все інше.</p>
      <button class="btn btn-lime" style="width:220px; margin-top:8px;" onclick="document.getElementById('photoInput').click()">Додати авто</button>
    </div>
  </div>

  <!-- HOME SCREEN -->
  <div class="screen" id="screen-home">
    <div class="topbar">
      <div class="logo"><div class="mark">A</div>AUTOTRACK</div>
      <div class="section-link" onclick="showScreen('settings')">Налаштування</div>
    </div>

    <div class="hero">
      <img id="carPhoto" src="" style="display:none;">
      <div class="hero-overlay">
        <div>
          <div class="hero-name" id="carNameLabel">Моє авто</div>
          <div class="hero-sub" id="carEntriesSub">0 ЗАПИСІВ</div>
        </div>
        <div class="hero-edit" onclick="document.getElementById('photoInput').click()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
        </div>
      </div>
    </div>

    <div class="stats">
      <div class="stat"><div class="val" id="statTotal">0</div><div class="lbl">Всього ₴</div></div>
      <div class="stat"><div class="val" id="statMonth">0</div><div class="lbl">Цей місяць</div></div>
      <div class="stat"><div class="val" id="statAvg">0</div><div class="lbl">Сер./міс</div></div>
      <div class="stat"><div class="val" id="statCount">0</div><div class="lbl">Записів</div></div>
    </div>

    <div class="section" style="flex:1;">
      <div class="section-head">
        <h2>Останні</h2>
        <div class="section-link" onclick="showScreen('history')">Всі →</div>
      </div>
      <div id="recentList"></div>
    </div>

    <div style="height:8px;"></div>
    <div class="bottom-nav">
      <div class="nav-item active" data-nav="home" onclick="showScreen('home')">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
        <span>Головна</span>
      </div>
      <div class="fab-slot">
        <div class="fab" onclick="openAddSheet()">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </div>
      </div>
      <div class="nav-item" data-nav="history" onclick="showScreen('history')">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
        <span>Історія</span>
      </div>
    </div>
  </div>

  <!-- HISTORY SCREEN -->
  <div class="screen" id="screen-history">
    <div class="topbar">
      <div class="section-link" onclick="showScreen('home')">← Назад</div>
      <div class="logo">ІСТОРІЯ</div>
      <div style="width:60px;"></div>
    </div>
    <div class="section" style="flex:1;">
      <div id="fullList"></div>
    </div>
    <div class="bottom-nav">
      <div class="nav-item" onclick="showScreen('home')">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
        <span>Головна</span>
      </div>
      <div class="fab-slot">
        <div class="fab" onclick="openAddSheet()">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </div>
      </div>
      <div class="nav-item active">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
        <span>Історія</span>
      </div>
    </div>
  </div>

  <!-- SETTINGS SCREEN -->
  <div class="screen" id="screen-settings">
    <div class="topbar">
      <div class="section-link" onclick="showScreen('home')">← Назад</div>
      <div class="logo">АВТО</div>
      <div style="width:60px;"></div>
    </div>
    <div class="section" style="flex:1;">
      <div class="field">
        <label>Назва авто</label>
        <input type="text" id="carNameInput" placeholder="напр. BMW M3">
      </div>
      <button class="btn btn-block" onclick="document.getElementById('photoInput').click()" style="margin-bottom:12px;">Змінити фото</button>
      <button class="btn btn-lime btn-block" onclick="saveCarName()">Зберегти</button>

      <div class="divider-label">Небезпечна зона</div>
      <button class="btn btn-block" style="border-color:var(--danger); color:var(--danger);" onclick="clearAll()">Очистити всі дані</button>
    </div>
  </div>

  <input type="file" id="photoInput" accept="image/*" onchange="handlePhoto(event)">

  <!-- ADD EXPENSE SHEET -->
  <div class="sheet-backdrop" id="addSheet">
    <div class="sheet">
      <div class="sheet-head">
        <h3 style="font-size:16px;">Новий запис</h3>
        <div class="sheet-close" onclick="closeAddSheet()">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </div>
      </div>

      <div class="field">
        <label>Категорія</label>
        <div class="chip-row" id="catChips"></div>
      </div>

      <div class="field">
        <label>Сума</label>
        <div class="amount-input-wrap">
          <span class="curr">₴</span>
          <input type="number" inputmode="decimal" id="amountInput" placeholder="0">
        </div>
        <div class="err" id="amountErr">Введіть суму більше нуля</div>
      </div>

      <div class="field">
        <label>Дата</label>
        <input type="date" id="dateInput">
      </div>

      <div class="field">
        <label>Нотатка (необов'язково)</label>
        <input type="text" id="noteInput" placeholder="напр. Заміна масла">
      </div>

      <button class="btn btn-lime btn-block" onclick="saveExpense()">Зберегти запис</button>
    </div>
  </div>

</div>

<script>
const CATEGORIES = [
  {id:'fuel', label:'Паливо', color:'#d7ff3d'},
  {id:'service', label:'Сервіс', color:'#37b1e0'},
  {id:'insurance', label:'Страховка', color:'#c78bf0'},
  {id:'parking', label:'Паркінг', color:'#f0a83b'},
  {id:'repair', label:'Ремонт', color:'#ff5a5a'},
  {id:'other', label:'Інше', color:'#8c8b86'}
];

let car = null;
let expenses = [];
let selectedCat = 'fuel';

function catInfo(id){ return CATEGORIES.find(c=>c.id===id) || CATEGORIES[5]; }
function fmt(n){ return Math.round(n).toLocaleString('uk-UA'); }
function fmtDate(d){
  const dt = new Date(d);
  return dt.toLocaleDateString('uk-UA', {day:'2-digit', month:'short'});
}

async function loadData(){
  try{
    const carRes = await window.storage.get('car-profile');
    car = carRes ? JSON.parse(carRes.value) : null;
  }catch(e){ car = null; }
  try{
    const expRes = await window.storage.get('expenses');
    expenses = expRes ? JSON.parse(expRes.value) : [];
  }catch(e){ expenses = []; }

  if(car && car.photo){
    showScreen('home');
    renderHome();
  } else {
    showScreen('onboard');
  }
}

function showScreen(name){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  const el = document.getElementById('screen-'+name);
  if(el) el.classList.add('active');
  if(name==='home') renderHome();
  if(name==='history') renderHistory();
  if(name==='settings'){
    document.getElementById('carNameInput').value = car ? car.name : '';
  }
}

function handlePhoto(evt){
  const file = evt.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = function(e){
    const img = new Image();
    img.onload = async function(){
      const maxDim = 1000;
      let w = img.width, h = img.height;
      if(w > h && w > maxDim){ h = h*(maxDim/w); w = maxDim; }
      else if(h > maxDim){ w = w*(maxDim/h); h = maxDim; }
      const canvas = document.createElement('canvas');
      canvas.width = w; canvas.height = h;
      canvas.getContext('2d').drawImage(img, 0, 0, w, h);
      const dataUrl = canvas.toDataURL('image/jpeg', 0.8);

      if(!car) car = {name:'Моє авто', photo:''};
      car.photo = dataUrl;
      try{
        await window.storage.set('car-profile', JSON.stringify(car));
      }catch(err){ console.error('storage error', err); }
      showScreen('home');
      renderHome();
    };
    img.src = e.target.result;
  };
  reader.readAsDataURL(file);
  evt.target.value = '';
}

async function saveCarName(){
  const name = document.getElementById('carNameInput').value.trim() || 'Моє авто';
  if(!car) car = {name:name, photo:''};
  car.name = name;
  try{ await window.storage.set('car-profile', JSON.stringify(car)); }catch(e){}
  renderHome();
  showScreen('home');
}

async function clearAll(){
  if(!confirm('Видалити всі дані про авто та витрати?')) return;
  try{
    await window.storage.delete('car-profile');
    await window.storage.delete('expenses');
  }catch(e){}
  car = null; expenses = [];
  showScreen('onboard');
}

function renderHome(){
  if(!car) return;
  const photoEl = document.getElementById('carPhoto');
  if(car.photo){
    photoEl.src = car.photo;
    photoEl.style.display = 'block';
  }
  document.getElementById('carNameLabel').textContent = car.name || 'Моє авто';
  document.getElementById('carEntriesSub').textContent = expenses.length + ' ЗАПИСІВ';

  const total = expenses.reduce((s,e)=>s+e.amount,0);
  const now = new Date();
  const thisMonth = expenses.filter(e=>{
    const d = new Date(e.date);
    return d.getMonth()===now.getMonth() && d.getFullYear()===now.getFullYear();
  }).reduce((s,e)=>s+e.amount,0);

  let avg = 0;
  if(expenses.length){
    const dates = expenses.map(e=>new Date(e.date).getTime());
    const minD = new Date(Math.min(...dates));
    const monthsSpan = Math.max(1, (now.getFullYear()-minD.getFullYear())*12 + (now.getMonth()-minD.getMonth()) + 1);
    avg = total / monthsSpan;
  }

  document.getElementById('statTotal').textContent = fmt(total);
  document.getElementById('statMonth').textContent = fmt(thisMonth);
  document.getElementById('statAvg').textContent = fmt(avg);
  document.getElementById('statCount').textContent = expenses.length;

  const recent = [...expenses].sort((a,b)=>new Date(b.date)-new Date(a.date)).slice(0,5);
  const listEl = document.getElementById('recentList');
  listEl.innerHTML = '';
  if(recent.length===0){
    listEl.innerHTML = '<div class="empty-state">Записів ще немає.<br>Натисніть + щоб додати перший.</div>';
  } else {
    recent.forEach(e=>listEl.appendChild(renderRow(e)));
  }
}

function renderHistory(){
  const listEl = document.getElementById('fullList');
  listEl.innerHTML = '';
  const sorted = [...expenses].sort((a,b)=>new Date(b.date)-new Date(a.date));
  if(sorted.length===0){
    listEl.innerHTML = '<div class="empty-state">Записів ще немає.</div>';
  } else {
    sorted.forEach(e=>listEl.appendChild(renderRow(e)));
  }
}

function renderRow(e){
  const info = catInfo(e.category);
  const row = document.createElement('div');
  row.className = 'expense-row';
  row.innerHTML = `
    <div class="cat-dot" style="background:${info.color}"></div>
    <div class="expense-info">
      <div class="expense-cat">${info.label}${e.note ? ' · '+escapeHtml(e.note) : ''}</div>
      <div class="expense-meta">${fmtDate(e.date)}</div>
    </div>
    <div class="expense-amt">₴${fmt(e.amount)}</div>
    <div class="expense-del" onclick="deleteExpense('${e.id}')">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/></svg>
    </div>
  `;
  return row;
}

function escapeHtml(str){
  const d = document.createElement('div');
  d.textContent = str;
  return d.innerHTML;
}

async function deleteExpense(id){
  expenses = expenses.filter(e=>e.id!==id);
  try{ await window.storage.set('expenses', JSON.stringify(expenses)); }catch(e){}
  renderHome();
  renderHistory();
}

function buildChips(){
  const wrap = document.getElementById('catChips');
  wrap.innerHTML = '';
  CATEGORIES.forEach(c=>{
    const chip = document.createElement('div');
    chip.className = 'chip' + (c.id===selectedCat ? ' selected' : '');
    chip.innerHTML = `<span style="width:6px;height:6px;border-radius:50%;background:${c.color};display:inline-block;"></span>${c.label}`;
    chip.onclick = ()=>{ selectedCat = c.id; buildChips(); };
    wrap.appendChild(chip);
  });
}

function openAddSheet(){
  selectedCat = 'fuel';
  buildChips();
  document.getElementById('amountInput').value = '';
  document.getElementById('noteInput').value = '';
  document.getElementById('amountErr').style.display = 'none';
  document.getElementById('dateInput').value = new Date().toISOString().slice(0,10);
  document.getElementById('addSheet').classList.add('active');
}
function closeAddSheet(){
  document.getElementById('addSheet').classList.remove('active');
}

async function saveExpense(){
  const amountEl = document.getElementById('amountInput');
  const amount = parseFloat(amountEl.value);
  const errEl = document.getElementById('amountErr');
  if(!amount || amount <= 0){
    errEl.style.display = 'block';
    amountEl.focus();
    return;
  }
  errEl.style.display = 'none';

  const entry = {
    id: 'e' + Date.now() + Math.random().toString(36).slice(2,7),
    category: selectedCat,
    amount: amount,
    date: document.getElementById('dateInput').value || new Date().toISOString().slice(0,10),
    note: document.getElementById('noteInput').value.trim()
  };
  expenses.push(entry);
  try{ await window.storage.set('expenses', JSON.stringify(expenses)); }catch(e){ console.error(e); }
  closeAddSheet();
  renderHome();
  renderHistory();
}

document.getElementById('amountInput').addEventListener('input', ()=>{
  document.getElementById('amountErr').style.display = 'none';
});

loadData();
</script>
</body>
</html>
